# CastPlay All-in-One Environment Configuration
# 复制此文件为 .env 并修改配置

# 应用配置
APP_NAME=CastPlay All-in-One
APP_VERSION=2.0.0
DEBUG=false

# 服务器配置
HOST=0.0.0.0
PORT=5000

# 数据库配置
DATABASE_PATH=data/castplay.db

# 文件存储路径
DATA_DIR=data
UPLOADS_DIR=data/uploads
CONVERTED_DIR=data/converted
THUMBNAILS_DIR=data/thumbnails
BACKUPS_DIR=backups

# 文件上传限制（字节）
MAX_FILE_SIZE=524288000  # 500MB

# JWT 认证配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7天

# WebSocket 配置
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# 后台任务配置
NUM_WORKERS=3
TASK_TIMEOUT=600

# 默认管理员
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
