# CastPlay Environment Configuration
# 复制此文件为 .env 并修改相应配置

# ============= 安全配置（生产环境必须设置） =============
# Flask 应用密钥 - 生产环境必须设置，建议64字符以上
SECRET_KEY=your-secure-secret-key-at-least-32-characters-long

# JWT 签名密钥 - 生产环境必须设置
JWT_SECRET_KEY=your-secure-jwt-secret-key-at-least-32-characters

# ============= 运行环境 =============
# 可选值: development, production, testing
FLASK_ENV=development

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============= 数据库配置 =============
# SQLite (开发环境默认)
# DATABASE_URL=sqlite:///castplay.db

# PostgreSQL (生产环境推荐)
# DATABASE_URL=postgresql://user:password@localhost:5432/castplay

# ============= Redis 配置 =============
# 方式1: 分别配置 Redis 连接参数
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 方式2: 直接配置完整 URL (优先级更高)
# CELERY_BROKER_URL=redis://:password@localhost:6379/0
# CELERY_RESULT_BACKEND=redis://:password@localhost:6379/0

# WebSocket 消息队列 (多实例部署时需要)
# SOCKETIO_MESSAGE_QUEUE=redis://:password@localhost:6379/1

# ============= CORS 配置 =============
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5001

# ============= WebSocket =============
WEBSOCKET_URL=ws://localhost:5001

# ============= 文件转换工具路径 =============
# LibreOffice (PPT转PDF)
# LIBREOFFICE_PATH=/usr/bin/soffice
# macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice

# FFmpeg (视频处理)
# FFMPEG_PATH=/usr/bin/ffmpeg
# macOS: /opt/homebrew/bin/ffmpeg
